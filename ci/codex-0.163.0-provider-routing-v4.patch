+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cross_provider_rejects_encrypted_message() {
+        assert!(
+            validate_cross_provider_message(
+                "openai",
+                "litellm",
+                false,
+                &AgentMessage::Encrypted("ciphertext".to_string())
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn cross_provider_allows_plaintext_message() {
+        assert!(
+            validate_cross_provider_message(
+                "openai",
+                "litellm",
+                false,
+                &AgentMessage::Plaintext("Reply with exactly BANANA".to_string())
+            )
+            .is_ok()
+        );
+    }
+
+    #[test]
+    fn same_provider_preserves_encrypted_message() {
+        assert!(
+            validate_cross_provider_message(
+                "openai",
+                "openai",
+                true,
+                &AgentMessage::Encrypted("ciphertext".to_string())
+            )
+            .is_ok()
+        );
+    }
+
+    #[test]
+    fn shared_gateway_child_cannot_receive_encrypted_message() {
+        // Same provider id, but the child cannot decrypt: the encrypted content is stripped
+        // during transport and the task would silently arrive empty.
+        assert!(
+            validate_cross_provider_message(
+                "litellm",
+                "litellm",
+                false,
+                &AgentMessage::Encrypted("ciphertext".to_string())
+            )
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn shared_gateway_child_can_receive_plaintext_message() {
+        assert!(
+            validate_cross_provider_message(
+                "litellm",
+                "litellm",
+                false,
+                &AgentMessage::Plaintext("Reply with exactly BANANA".to_string())
+            )
+            .is_ok()
+        );
+    }
+
+    #[test]
+    fn different_providers_reject_encrypted_message_even_when_child_can_decrypt() {
+        assert!(
+            validate_cross_provider_message(
+                "litellm",
+                "openai",
+                true,
+                &AgentMessage::Encrypted("ciphertext".to_string())
+            )
+            .is_err()
+        );
+    }
+}
