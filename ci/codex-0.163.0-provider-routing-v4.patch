+/// Resolves a thread's model provider id without requiring the thread to be
+/// loaded: loaded threads report their live snapshot, evicted or queued
+/// recipients fall back to their stored rollout metadata.
+async fn thread_provider_id(
+    state: &ThreadManagerState,
+    thread_id: ThreadId,
+) -> CodexResult<String> {
+    match state.get_thread(thread_id).await {
+        Ok(thread) => Ok(thread.config_snapshot().await.model_provider_id),
+        Err(err) if matches!(err.details(), CodexErrorDetails::ThreadNotFound(_)) => {
+            let stored = state
+                .read_stored_thread(ReadThreadParams {
+                    thread_id,
+                    include_archived: true,
+                    include_history: false,
+                })
+                .await?;
+            Ok(stored.model_provider)
+        }
+        Err(err) => Err(err),
+    }
+}
+
+/// Fail-closed trust-boundary check for inter-agent transport. Encrypted
+/// message content may only cross threads that share a model provider: the
+/// receiving provider would otherwise receive ciphertext it cannot decrypt.
+/// Plaintext messages are always allowed. The error names provider ids only;
+/// message content is never included.
+async fn validate_cross_provider_communication(
+    state: &ThreadManagerState,
+    communication: &InterAgentCommunication,
+    context: &AgentCommunicationContext,
+    receiver_id: ThreadId,
+) -> CodexResult<()> {
+    if communication.encrypted_content.is_none() {
+        return Ok(());
+    }
+    let sender_provider = thread_provider_id(state, context.sender_thread_id()).await?;
+    let receiver_provider = thread_provider_id(state, receiver_id).await?;
+    if sender_provider != receiver_provider {
+        return Err(CodexErr::InvalidRequest(format!(
+            "cross-provider agent messaging requires plaintext content: sender provider `{sender_provider}`, receiver provider `{receiver_provider}`"
+        )));
+    }
+    Ok(())
+}
