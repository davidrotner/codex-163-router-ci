+
+/// Encrypted task content may only be delivered to a child that can actually decrypt it.
+///
+/// Provider ids alone are not a trust boundary: one gateway can front several upstream
+/// vendors, so a parent and a child can share a provider id while living in different
+/// encryption domains. Only OpenAI-family providers keep `encrypted_content` on the wire;
+/// every other provider strips it before the request, so an encrypted task would arrive
+/// empty instead of failing loudly. Decide on the child's decryption capability first and
+/// keep the provider-id comparison as the secondary trust boundary.
+fn validate_cross_provider_message(
+    parent_provider_id: &str,
+    child_provider_id: &str,
+    child_can_decrypt: bool,
+    message: &AgentMessage,
+) -> Result<(), String> {
+    if !matches!(message, AgentMessage::Encrypted(_)) {
+        return Ok(());
+    }
+    if !child_can_decrypt {
+        return Err(format!(
+            "spawn_agent cannot deliver encrypted task content to provider `{child_provider_id}`: the child provider cannot decrypt it, and the content is dropped during transport"
+        ));
+    }
+    if parent_provider_id != child_provider_id {
+        return Err(format!(
+            "spawn_agent across providers requires plaintext task content: parent provider `{parent_provider_id}`, child provider `{child_provider_id}`"
+        ));
+    }
+    Ok(())
+}
