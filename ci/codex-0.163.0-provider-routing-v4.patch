+/// Runs `f` on an OS thread with a large stack. Two-thread control harnesses
+/// exceed the default 2 MiB test-thread stack in debug builds during setup and
+/// teardown, unrelated to the behavior under test.
+fn with_big_stack<T: Send + 'static>(f: impl FnOnce() -> T + Send + 'static) -> T {
+    std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(f)
+        .expect("spawn big-stack test thread")
+        .join()
+        .expect("big-stack test thread panicked")
+}
+
+fn big_stack_runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("build current-thread runtime")
+}
+
+fn config_with_provider(config: &Config, provider_id: &str) -> Config {
+    let mut config = config.clone();
+    config.model_provider_id = provider_id.to_string();
+    config.model_provider = config
+        .model_providers
+        .get(provider_id)
+        .cloned()
+        .unwrap_or_else(|| panic!("{provider_id} provider should be configured"));
+    config
+}
+
+async fn start_thread_with_provider(
+    harness: &AgentControlHarness,
+    provider_id: &str,
+) -> (ThreadId, Arc<CodexThread>) {
+    let new_thread = harness
+        .manager
+        .start_thread(StartThreadOptions::new(config_with_provider(
+            &harness.config,
+            provider_id,
+        )))
+        .await
+        .expect("start thread");
+    (new_thread.thread_id, new_thread.thread)
+}
+
+#[test]
+fn cross_provider_encrypted_message_fails_closed_without_payload_leak() {
+    with_big_stack(|| {
+        let rt = big_stack_runtime();
+        rt.block_on(async {
+            let harness = AgentControlHarness::new().await;
+            let (sender_id, _sender) = harness.start_thread().await;
+            let (receiver_id, _receiver) = start_thread_with_provider(&harness, "ollama").await;
+            let payload = "SECRET_ENCRYPTED_PAYLOAD_FOR_TESTS";
+            let communication = InterAgentCommunication::new_encrypted(
+                AgentPath::root(),
+                AgentPath::try_from("/root/worker").expect("agent path"),
+                Vec::new(),
+                payload.to_string(),
+                /*trigger_turn*/ false,
+            );
+
+            let err = harness
+                .control
+                .send_inter_agent_communication(
+                    receiver_id,
+                    communication,
+                    AgentCommunicationContext::new(AgentCommunicationKind::Message, sender_id),
+                    Default::default(),
+                )
+                .await
+                .expect_err("cross-provider encrypted message must be rejected");
+            let rendered = err.to_string();
+            assert!(rendered.contains("cross-provider"), "{rendered}");
+            assert!(
+                !rendered.contains(payload),
+                "rejection must not leak the encrypted payload: {rendered}"
+            );
