+use serde::Deserialize;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+const REGISTRY_PATH_ENV: &str = "CODEX_ROUTER_MODELS_PATH";
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+pub(crate) struct ModelEntry {
+    pub(crate) provider: String,
+    pub(crate) upstream_model: String,
+}
+
+#[derive(Debug, Clone, Default)]
+pub(crate) struct ModelRegistry {
+    entries: HashMap<String, ModelEntry>,
+}
+
+impl ModelRegistry {
+    pub(crate) fn load(path: &Path) -> Result<Self, String> {
+        match std::fs::read_to_string(path) {
+            Ok(contents) => Self::from_yaml(&contents)
+                .map_err(|err| format!("invalid model registry {}: {err}", path.display())),
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(Self::default()),
+            Err(err) => Err(format!(
+                "failed to read model registry {}: {err}",
+                path.display()
+            )),
+        }
+    }
+
+    pub(crate) fn from_yaml(yaml: &str) -> Result<Self, String> {
+        if yaml.trim().is_empty() {
+            return Ok(Self::default());
+        }
+        let entries: HashMap<String, ModelEntry> =
+            serde_yaml::from_str(yaml).map_err(|err| err.to_string())?;
+        Ok(Self { entries })
+    }
+
+    pub(crate) fn load_default() -> Result<Self, String> {
+        if let Some(path) = std::env::var_os(REGISTRY_PATH_ENV) {
+            return Self::load(Path::new(&path));
+        }
+        match Self::default_path() {
+            Some(path) => Self::load(&path),
+            None => Ok(Self::default()),
+        }
+    }
+
+    pub(crate) fn lookup(&self, model_slug: &str) -> Option<&ModelEntry> {
+        self.entries.get(model_slug)
+    }
+
+    fn default_path() -> Option<PathBuf> {
+        dirs::home_dir().map(|home| home.join(".config/codex-router/models.yaml"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Write;
+
+    const SAMPLE: &str = r#"
+nemotron-3.5-lightning:
+  provider: litellm
+  upstream_model: nvidia/nemotron-3.5-lightning
+gpt-6-astra:
+  provider: openai
+  upstream_model: gpt-6-astra
+"#;
+
+    #[test]
+    fn parses_entries_and_looks_up_by_slug() {
+        let registry = ModelRegistry::from_yaml(SAMPLE).expect("registry");
+        let entry = registry.lookup("nemotron-3.5-lightning").expect("entry");
+        assert_eq!(entry.provider, "litellm");
+        assert_eq!(entry.upstream_model, "nvidia/nemotron-3.5-lightning");
+    }
+
+    #[test]
+    fn unknown_slug_is_none() {
+        let registry = ModelRegistry::from_yaml(SAMPLE).expect("registry");
+        assert!(registry.lookup("unknown").is_none());
+    }
+
+    #[test]
+    fn empty_registry_is_allowed() {
+        let registry = ModelRegistry::from_yaml("  \n").expect("registry");
+        assert!(registry.lookup("nemotron-3.5-lightning").is_none());
+    }
+
+    #[test]
+    fn malformed_registry_is_an_error() {
+        assert!(ModelRegistry::from_yaml("not: [valid").is_err());
+    }
+
+    #[test]
+    fn missing_file_is_empty() {
+        let registry =
+            ModelRegistry::load(Path::new("/nonexistent/models.yaml")).expect("registry");
+        assert!(registry.lookup("nemotron-3.5-lightning").is_none());
+    }
+
+    #[test]
+    fn reads_registry_file() {
+        let mut file = tempfile::NamedTempFile::new().expect("temp file");
+        file.write_all(SAMPLE.as_bytes()).expect("write");
+        let registry = ModelRegistry::load(file.path()).expect("registry");
+        assert!(registry.lookup("gpt-6-astra").is_some());
+    }
+}
