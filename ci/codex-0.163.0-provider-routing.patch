+fn resolve_spawn_agent_model_provider(config: &mut Config) -> Result<(), String> {
+    let Some(model_slug) = config.model.clone() else {
+        return Ok(());
+    };
+    let registry = ModelRegistry::load_default()?;
+    let Some(entry) = registry.lookup(&model_slug) else {
+        return Ok(());
+    };
+    let provider = config
+        .model_providers
+        .get(&entry.provider)
+        .cloned()
+        .ok_or_else(|| {
+            format!(
+                "spawn_agent model `{model_slug}` resolved to unknown provider `{}`",
+                entry.provider
+            )
+        })?;
+    tracing::info!(
+        model = %model_slug,
+        provider = %entry.provider,
+        upstream_model = %entry.upstream_model,
+        "spawn_agent model resolved from router registry"
+    );
+    config.model_provider_id = entry.provider.clone();
+    config.model_provider = provider;
+    config.model = Some(entry.upstream_model.clone());
+    Ok(())
+}
